{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Adaptive layout written books with an HTML-subset markup, i18n-aware reflow, and a custom screen.",
  "authors": [
    "PhantomDaze"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.PhantomDaze.flexibook.fabric.FlexiBookFabric"
    ],
    "client": [
      "io.github.PhantomDaze.flexibook.fabric.FlexiBookFabricClient"
    ]
  },
  "depends": {
    "fabricloader": "${loader_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
