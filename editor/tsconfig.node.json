{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "dist-electron",
    "declaration": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "target": "ES2020"
  },
  "include": ["src/main/**/*.ts"]
}
